<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>N1MMMobileCounty.App</RootNamespace>
    <AssemblyName>N1MMMobileCountyAutomation</AssemblyName>
    <Product>N1MM Mobile County Automation</Product>
    <Authors>K5JSG</Authors>
    <Description>Reads a GPS, finds the county, and keeps N1MM Logger+ Rover QTH up to date for QSO parties.</Description>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationIcon>..\..\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\logo-256.png" LogicalName="logo-256.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\N1MMMobileCounty.Core\N1MMMobileCounty.Core.csproj" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
